# From the service-account JSON downloaded in Firebase Console → Project
# settings → Service accounts → Generate new private key. Copy
# project_id, client_email, and private_key. Keep the private key in double
# quotes, with its \n sequences exactly as they appear in the JSON file.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-key\n-----END PRIVATE KEY-----\n"

# Encrypts CNIC and phone numbers before they are written to Firestore, and
# turns each CNIC into the hashed document ID its case is stored under.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# BACK THIS UP somewhere safe and separate from the database. It is not
# recoverable: without it every stored CNIC and phone number is unreadable
# and no existing case can be looked up again. Use the same value in local
# development and on the server, or each will be unable to read the other's
# records.
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Used once, by scripts/seed.js, to create the single bootstrap admin
# account. Whoever fills these in and runs `npm run seed` is the only
# person who ever knows this password — it's read from here, never
# hardcoded in the seed script itself. Safe to remove these three lines
# from your own .env.local after the admin account has been created; every
# other account (KDF and Social Welfare staff, further admins) should be
# created afterward from the admin's own "+ New User" screen in the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Forum Administrator
